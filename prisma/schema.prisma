// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
} 


//contents
model Contents {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  termsAndCondition String
  type              String @unique @default("main")
  privacyPolicy     String 
  refundPolicy      String
  shippingPolicy    String
  aboutUs           String
  copyRight         String
  footerText        String  
  adminCommotions   Float @default(5)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

 @@map("contents")
} 

model Faq {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  question String 
  answer String
  categoryId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  category Categories @relation(fields: [categoryId], references: [id])
}


model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String?
  email       String   @unique
  bio         String?
  password    String?
  fcmToken    String?
  status      status   @default(active)
  role        Role     @default(user)
  profile     String?
  phoneNumber String?
  isVerified  Boolean  @default(false)
  customerId String?
  avgRating   Float   @default(0)
  totalReview Int     @default(0)
  location   Json?
  expireAt    DateTime? @default(now())
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  verification     Verification? 
  serviceProviderInfo     serviceProviderInfo? 
  workSchedule     workSchedule[] 
  deviceHistory    DeviceHistory[]  
  notifications    Notification[]  
  verificationRequests    VerificationRequest[]  
  // reviews    Reviews[]  
  reviewsReceived Reviews[] @relation("UserReviews")
  reviewsGiven    Reviews[] @relation("AuthorReviews")
  //bookings
  bookings        Bookings[] @relation("UserBookings")
  providerBookings Bookings[] @relation("ProviderBookings")
  //message
  sendMessages  Messages[] @relation("sender")
  receiverMessages  Messages[] @relation("receiver")
  callSendHistory  CallHistory[] @relation("sender")
  callReceiveHistory  CallHistory[] @relation("receiver")
  participants Participants[] 
  payments Payments[] 
  providerPayments Payments[] @relation("ProviderPayments")
  favorites Favorites[] 
  address Address[] 

}


model VerificationRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  reason    String?
  status    VERIFICATION_STATUS  @default(pending)


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  documents Images[]
  notifications Notification[]

  user User @relation(fields: [userId], references: [id])
}

model DeviceHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  ip        String?
  browser   String?
  os        String?
  device    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Verification { 
  userId    String   @map("_id") @db.ObjectId
  otp       Int
  expiredAt DateTime?
  status    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])

  @@id([userId])
}

model Address {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])



  addressLine1 String?
  addressLine2 String?

  city        String?
  state       String?
  postalCode  String?
  country     String?

  location    Json

  isDefault   Boolean  @default(false)
  isDeleted   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorites {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  serviceProviderId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])
  serviceProvider serviceProviderInfo @relation(fields: [serviceProviderId], references: [userId])
}


model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String? @db.ObjectId
  bookingId String? @db.ObjectId 
  verificationRequestId String? @db.ObjectId 
  message String
  description String?
  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   user    User?     @relation(fields: [receiverId], references: [id]) 
   booking    Bookings?     @relation(fields: [bookingId], references: [id]) 
    verificationRequest    VerificationRequest?     @relation(fields: [verificationRequestId], references: [id])
}

model workSchedule {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  day  Days  
  startTime DateTime
  endTime DateTime
  status Boolean @default(true)  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  user User @relation(fields: [userId], references: [id])  
}


model serviceProviderInfo {
      
  userId    String   @map("_id") @db.ObjectId 
  stripeAccountId String?
  palliativeCare String? 
  bio String?
  coverImage String?
  drivingLicense String?
  businessProfiles String?
  documents String?
  perHourPrice Float
  experienceOptionId String? @db.ObjectId 
  qualifiedCarer String?
 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  user User @relation(fields: [userId], references: [id]) 
  experience ExperienceOptions? @relation(fields: [experienceOptionId], references: [id]) 
   
  images Images[]
  specialistsIn SpecialistsIn[]
  
  othersRequiredTasks OthersRequiredTasks[]
  favorites Favorites[] 

  @@id([userId])
}

model ExperienceOptions {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  value String 
  isDeleted Boolean @default(false)

 createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceProviderInfo serviceProviderInfo[] 
}



model SpecialistsIn{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  categoryId String @db.ObjectId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  serviceProviderInfo serviceProviderInfo @relation(fields: [userId], references: [userId]) 
  category Categories @relation(fields: [categoryId], references: [id])

}

model OthersRequiredTasks{
  
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  othersTaskId String @db.ObjectId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  serviceProviderInfo serviceProviderInfo @relation(fields: [userId], references: [userId])
  othersTask OthersTask @relation(fields: [othersTaskId], references: [id])
  
}

model OthersTask {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  value String 
  isDeleted Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  othersRequiredTasks OthersRequiredTasks[]

}

model Categories{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  image String 
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  specialistsIn SpecialistsIn[] 
  subCategories SubCategories[]
  faq Faq[]
}

model SubCategories{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  categoryId String @db.ObjectId
  image String 
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Categories @relation(fields: [categoryId], references: [id])
}

model Reviews {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  rating Float 
  review String
  userId String @db.ObjectId
  authorId String @db.ObjectId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  user   User @relation("UserReviews", fields: [userId], references: [id])
  author User @relation("AuthorReviews", fields: [authorId], references: [id])
 
  
} 


model Bookings {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  addressId String? @db.ObjectId
  providerId   String        @db.ObjectId
  isPaid Boolean @default(false)
  bookingType BOOKING_TYPE @default(one_time) 
  status BookingStatus @default(pending)
  price Float
  startDate DateTime
  endDate DateTime? // For weekly: when the recurring booking ends (null = unlimited)
  totalHours Float
  isActive Boolean @default(true)
  nextBooking String? @db.ObjectId

  isDeleted Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              User               @relation("UserBookings",    fields: [userId],    references: [id])
  provider          User               @relation("ProviderBookings",fields: [providerId],references: [id])
  bookingDays       BookingDays[]
  notifications     Notification[]
  payments          Payments[]
}


 model BookingDays {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String          @db.ObjectId
  day           Days
  startTime     DateTime        // absolute datetime (2025-01-13T14:15:00Z)
  endTime       DateTime
  durationHours Int             // e.g. 2
  status        BookingDayStatus @default(pending)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  booking   Bookings   @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([day])
  @@map("booking_days")
} 

model Payments {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  userId        String         @db.ObjectId
  providerId        String         @db.ObjectId
  bookingId     String         @db.ObjectId
  amount        Float
  status        PAYMENT_STATUS @default(pending)
  transactionId String?        @unique
  paymentMethod String?
  nextPaymentDate DateTime?
  adminParentage       Float?
  providerParentage       Float?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user              User                              @relation(fields: [userId], references: [id])
  provider          User                              @relation("ProviderPayments", fields: [providerId], references: [id])
  booking           Bookings                          @relation(fields: [bookingId], references: [id]) 

  @@index([providerId])
  @@index([bookingId])
  @@index([status])
  @@index([nextPaymentDate])
  @@map("payments")
}

model Chat {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  status CHAT_STATUS @default(pending) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  participants Participants[]
  messages Messages[]
}

model Participants {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  chatId String @db.ObjectId
  userId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  user User? @relation(fields: [userId], references: [id])
  chat Chat @relation(fields: [chatId], references: [id])

  @@unique([chatId, userId])

}


model CallHistory {
   id String @id @default(auto()) @map("_id") @db.ObjectId
   senderId String @db.ObjectId
   receiverId String @db.ObjectId 
   type CALL_TYPE @default(audio_call)


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  sender User? @relation("sender", fields: [senderId], references: [id])
  receiver User @relation("receiver",fields: [receiverId], references: [id])
}


model Messages{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  text String?
  seen Boolean @default(false)
  chatId String @db.ObjectId
  senderId String @db.ObjectId
  receiverId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat    Chat @relation( fields: [chatId], references: [id])
  sender    User @relation("sender", fields: [senderId], references: [id])
  receiver User @relation("receiver", fields: [receiverId], references: [id])

  images Images[]
  @@index([senderId, receiverId])
  @@index([chatId])
  @@index([createdAt])

}

model Images {
   id String @id @default(auto()) @map("_id") @db.ObjectId
   url String 
   messageId String? @db.ObjectId 
   userId String? @db.ObjectId  
   requestId String? @db.ObjectId  

   message Messages? @relation(fields: [messageId], references: [id])
   serviceProviderInfo serviceProviderInfo? @relation(fields: [userId], references: [userId])
   verificationRequest VerificationRequest? @relation(fields: [requestId], references: [id])

}

model webAboutUs {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  image String
  title String
  content String
  buttonText String
  buttonLink String
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model services {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  description String
  image String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientReview {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  image String
  name String
  review String
  rating Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}




