// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
} 


//contents
model Contents {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  termsAndCondition String
  type              String @unique @default("main")
  privacyPolicy     String 
  refundPolicy      String
  shippingPolicy    String
  aboutUs           String
  copyRight         String
  footerText        String  
  adminCommotions   Float @default(5)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

 @@map("contents")
} 


model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String?
  email       String   @unique
  password    String?
  status      status   @default(active)
  role        Role     @default(user)
  profile     String?
  phoneNumber String?
  customerId String?
  location   Json?
  expireAt    DateTime? @default(now())
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  verification     Verification? 
  serviceProviderInfo     serviceProviderInfo? 
  workSchedule     workSchedule[] 
  deviceHistory    DeviceHistory[]  
  notifications    Notification[]  
  // reviews    Reviews[]  
  reviewsReceived Reviews[] @relation("UserReviews")
  reviewsGiven    Reviews[] @relation("AuthorReviews")
  //bookings
  bookings        Bookings[] @relation("UserBookings")
  providerBookings Bookings[] @relation("ProviderBookings")
  //message
  sendMessages  Messages[] @relation("sender")
  receiverMessages  Messages[] @relation("receiver")
  participants Participants[] 
  payments Payments[] 

}

model DeviceHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  ip        String?
  browser   String?
  os        String?
  device    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Verification { 
  userId    String   @map("_id") @db.ObjectId
  otp       Int
  expiredAt DateTime?
  status    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])

  @@id([userId])
}

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String? @db.ObjectId
  bookingId String? @db.ObjectId 
  message String
  description String?
  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   user    User?     @relation(fields: [receiverId], references: [id]) 
   booking    Bookings?     @relation(fields: [bookingId], references: [id]) 
}

model workSchedule {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  day  Days  
  startTime DateTime
  endTime DateTime
  status Boolean @default(true)  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  user User @relation(fields: [userId], references: [id])

 
}


model serviceProviderInfo {
  userId    String   @map("_id") @db.ObjectId 
  palliativeCare String?
  drivingLicense String?
  businessProfiles String?
  documents String?
  perHourPrice Float
  experienceOptionId String? @db.ObjectId 
  qualifiedCarer String?
 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  user User @relation(fields: [userId], references: [id]) 
  experience ExperienceOptions? @relation(fields: [experienceOptionId], references: [id]) 
   
  images Images[]
  specialistsIn SpecialistsIn[]
  
  othersRequiredTasks OthersRequiredTasks[]

  @@id([userId])
}

model ExperienceOptions {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  value String 
  isDeleted Boolean @default(false)

 createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceProviderInfo serviceProviderInfo[] 
}



model SpecialistsIn{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  categoryId String @db.ObjectId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  serviceProviderInfo serviceProviderInfo @relation(fields: [userId], references: [userId]) 
  category Categories @relation(fields: [categoryId], references: [id])

}

model OthersRequiredTasks{
  
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  othersTaskId String @db.ObjectId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  serviceProviderInfo serviceProviderInfo @relation(fields: [userId], references: [userId])
  othersTask OthersTask @relation(fields: [othersTaskId], references: [id])
  
}

model OthersTask {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  value String 
  isDeleted Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  othersRequiredTasks OthersRequiredTasks[]

}

model Categories{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  image String 
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  specialistsIn SpecialistsIn[] 
  subCategories SubCategories[]
}

model SubCategories{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  categoryId String @db.ObjectId
  image String 
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Categories @relation(fields: [categoryId], references: [id])
}

model Reviews {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  rating Float 
  review String
  userId String @db.ObjectId
  authorId String @db.ObjectId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  user   User @relation("UserReviews", fields: [userId], references: [id])
  author User @relation("AuthorReviews", fields: [authorId], references: [id])
 
  
} 


model Bookings {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  providerId   String        @db.ObjectId 
  isPaid Boolean @default(false)  
  bookingType BOOKING_TYPE @default(one_time)
  price Float
  startDate DateTime
  totalHours Float
  isActive Boolean @default(false)
  nextBooking String? @db.ObjectId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              User               @relation("UserBookings",    fields: [userId],    references: [id])
  provider          User               @relation("ProviderBookings",fields: [providerId],references: [id])
  bookingDays     BookingDays[]
  notifications     Notification[]
  payments     Payments[] 
}


 model BookingDays {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String          @db.ObjectId
  day           Days
  startTime     DateTime        // absolute datetime (2025-01-13T14:15:00Z)
  endTime       DateTime
  durationHours Int             // e.g. 2
  status        BookingDayStatus @default(pending)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  booking   Bookings   @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([day])
  @@map("booking_days")
} 

model Payments {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  userId        String         @db.ObjectId
  providerId        String         @db.ObjectId
  bookingId     String         @db.ObjectId
  amount        Float
  status        PAYMENT_STATUS @default(pending)
  transactionId String?        @unique
  paymentMethod String?
  nextPaymentDate DateTime?
  adminParentage       Float?
  providerParentage       Float?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  serviceProvider   User               @relation(fields: [providerId], references: [id])
  booking           Bookings           @relation(fields: [bookingId], references: [id])

  @@index([providerId])
  @@index([bookingId])
  @@index([status])
  @@index([nextPaymentDate])
  @@map("payments")
}

model Chat {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  status CHAT_STATUS @default(pending) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  participants Participants[]
  messages Messages[]
}

model Participants {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  chatId String @db.ObjectId
  userId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  user User @relation(fields: [userId], references: [id])
  chat Chat @relation(fields: [chatId], references: [id])

  @@unique([chatId, userId])

}

model Messages{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  text String?
  seen Boolean @default(false)
  chatId String @db.ObjectId
  senderId String @db.ObjectId
  receiverId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat    Chat @relation( fields: [chatId], references: [id])
  sender    User @relation("sender", fields: [senderId], references: [id])
  receiver User @relation("receiver", fields: [receiverId], references: [id])

  images Images[]
  @@index([senderId, receiverId])
  @@index([chatId])
  @@index([createdAt])

}

model Images {
   id String @id @default(auto()) @map("_id") @db.ObjectId
   url String 
   messageId String? @db.ObjectId 
   userId String? @db.ObjectId 

   message Messages? @relation(fields: [messageId], references: [id])
   serviceProviderInfo serviceProviderInfo? @relation(fields: [userId], references: [userId])

}

// ─── Enums ───
enum BookingDayStatus {
  pending
  confirmed
  completed
  canceled
}

enum SlotStatus {
  available
  booked
  blocked
}

enum RecurringStatus {
  pending
  processing
  paid
  failed
  skipped
}


enum BookingStatus {
  requested
  accepted
  confirmed
  ongoing
  complete
  canceled
}

enum BOOKING_TYPE {
  one_time
  weekly
}

enum status {
  active
  blocked
}
enum CHAT_STATUS {
 pending
 accepted
 blocked
}
 

enum PAYMENT_STATUS { 
  pending
  paid
  refunded
  canceled

}
enum Days {
  Mon
  Tue
  Wed  
  Thu   
  Fri   
  Sat   
  Sun  
}
 
enum Role {
  admin
  sub_admin
  supper_admin
  user
  service_provider
}