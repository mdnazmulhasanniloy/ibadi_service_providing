// ─── Enums ───
enum BookingDayStatus {
  pending
  confirmed
  completed
  canceled
} 

enum VERIFICATION_STATUS {
  pending
  verified
  rejected
}

enum SlotStatus {
  available
  booked
  blocked
}

enum RecurringStatus {
  pending
  processing
  paid
  failed
  skipped
}


enum BookingStatus {
  pending
  requested
  accepted 
  ongoing
  complete
  canceled
}

enum BOOKING_TYPE {
  one_time
  weekly
}

enum status {
  active
  blocked
}
enum CHAT_STATUS {
 pending
 accepted
 blocked
}
 

enum PAYMENT_STATUS { 
  pending
  paid
  refunded
  canceled

}
enum Days {
  Mon
  Tue
  Wed  
  Thu   
  Fri   
  Sat   
  Sun  
}

enum CALL_TYPE {
  audio_call
  video_call
}
 
enum Role {
  admin
  sub_admin
  supper_admin
  user
  service_provider
}